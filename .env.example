# Ou partent les messages du formulaire.
#
# Sans cette variable, le formulaire refuse d'envoyer et rend l'adresse
# aa@dfend.swiss au visiteur. Il ne repond jamais « envoye » sans destination :
# un formulaire qui perd les messages en silence est pire que pas de formulaire.
#
# Elle ne porte pas le prefixe NEXT_PUBLIC_ : elle est lue par l'action serveur
# et ne part jamais dans le paquet du navigateur. La passe 14 le verifie.
#
# Destination a trancher, voir tasks/todo.md #4 : un scenario Make.com, un
# endpoint sur le serveur Fortiva deja en place, ou un service de formulaire.
DFEND_FORM_WEBHOOK=

# Facultatif. Envoye en en-tete Authorization: Bearer <valeur> si la
# destination demande un jeton.
DFEND_FORM_TOKEN=
